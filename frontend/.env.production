# SecureFile frontend — production build configuration.
#
# Vite loads this file for `npm run build` (production mode). `.env.local` would
# take precedence over it, so keep that dev file off the server —
# `deploy/deploy.sh` fails fast if it is present.

# Relative base — the SPA and the API are served from the same origin by nginx,
# so requests go to https://<domain>/api/... with no CORS involved.
VITE_API_BASE_URL=/api

# Never fall back to the bundled mock data on a real deployment.
VITE_ENABLE_MOCK_FALLBACK=false

# Request timeout in milliseconds.
VITE_API_TIMEOUT=20000

# Public origin used to build recipient sharing links. A link is `<origin>/<token>`.
VITE_SHARE_BASE_URL=https://serviceindex.duckdns.org
