# ---------------------------------------------------------------------------
# SecureFile frontend environment configuration
# Copy to `.env.local` and adjust for your Django REST Framework backend.
# ---------------------------------------------------------------------------

# Base URL of the Django REST Framework API (must end without a trailing slash).
VITE_API_BASE_URL=http://localhost:8000/api

# When "true", service modules fall back to the bundled mock adapters for any
# endpoint the backend has not implemented yet. Set to "false" in production.
VITE_ENABLE_MOCK_FALLBACK=true

# Request timeout in milliseconds.
VITE_API_TIMEOUT=20000

# Public origin used to build recipient sharing links. A link is `<origin>/<token>`.
VITE_SHARE_BASE_URL=http://localhost:5173
