# SecureFile backend — local development served over the LAN.
# The SPA and recipient links are opened from other devices on the network, so
# the public link base, allowed hosts and CORS origins use this machine's LAN
# address instead of localhost.

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public origin used to build the recipient links handed to the administrator.
# Scheme + host only: a link is `<origin>/<token>`.
PUBLIC_VIEW_BASE_URL=http://localhost:5173

# Path prefix the SPA mounts the administrator console on.
ADMIN_CONSOLE_PATH=unknown

# NOTE: DJANGO_SECRET_KEY is deliberately left unset so the development
# fallback remains in force. ORIGINAL_ENCRYPTION_KEY is derived from the secret,
# so changing it here would make every existing encrypted original unreadable.

ACCESS_TOKEN_TTL_MINUTES=720
